VITE_API_BASE_URL=http://localhost:3000/

# Para trabajar con datos ficticios sin backend, reemplaza la línea anterior por:
# VITE_API_BASE_URL=/mock-api/
# El frontend selecciona automáticamente V1 y lee json/future/. Solo pnpm dev / pnpm dev:network.
# Los servicios futuros agregan /v1 y usan json/future/ (docs/future-api-contract.md).
# No añadas /v1 a VITE_API_BASE_URL: lo incorpora el servicio correspondiente.
# Reinicia Vite al cambiar .env o los JSON; las operaciones se guardan solo en memoria.

# Para usar el futuro backend con URL real, activa además:
# VITE_API_CONTRACT=v1
# Para conservar expresamente las rutas actuales sin versión:
# VITE_API_CONTRACT=legacy

# En AWS Amplify configura esta misma variable con la URL HTTPS del backend de pruebas.
# Las variables VITE_* se incorporan al bundle durante el build y nunca deben contener secretos.

# Opcional: apaga la recarga automática de Vite al guardar (por defecto está encendida).
# Solo hace falta si el websocket de Vite falla en tu red. Reinicia Vite después de cambiarlo.
# VITE_DISABLE_HMR=true
